<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!--
      Chọn 1 dòng đúng với máy của bạn (SQL Server 2022):
      - Instance mặc định:   Server=localhost
      - Bản Express:         Server=.\SQLEXPRESS
      - Tên máy cụ thể:      Server=TEN-MAY\TEN-INSTANCE
      - Đăng nhập SQL (sa):  Server=localhost;User Id=sa;Password=matkhau;
    -->
    <add name="CafeDB"
         connectionString="Server=localhost\SQLEXPRESS02;Database=CafeDB;Integrated Security=true;TrustServerCertificate=true"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
